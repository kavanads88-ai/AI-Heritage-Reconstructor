<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: allow plain HTTP to any host, so a laptop on the same Wi-Fi
     (http://192.168.x.x:8000) works during development. Never shipped in release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
